{% extends "base.html" %}

{% block title %}My Journey — SAHAY-V{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto px-4 py-8">

    <!-- Page Title & Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold font-heading text-slate-800">
                Explore My Journey 🧭
            </h1>
            <p class="text-slate-600 text-sm mt-1">
                Track your emotional wellbeing, observe patterns, and celebrate peaceful moments.
            </p>
        </div>

        <!-- Floating / Header "+ Add Entry" CTA -->
        <button id="openAddModalBtn" 
                class="bg-gradient-sahay text-white font-semibold px-5 py-3 rounded-2xl shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all flex items-center gap-2 self-start md:self-auto">
            <span>+ Add Entry</span>
            <span>📝</span>
        </button>
    </div>

    <!-- 3 Summary Average Cards (Today / Week / Month) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        
        <!-- Today Average -->
        <div class="glass-card p-5 rounded-2xl border-l-4 border-l-purple-500 shadow-sm flex items-center justify-between">
            <div>
                <div class="text-xs font-semibold text-purple-700 uppercase tracking-wider mb-1">Today's Average</div>
                <div class="text-3xl font-bold font-heading text-slate-800 flex items-baseline gap-2">
                    <span id="todayAvgText">—</span>
                    <span class="text-xs text-slate-500 font-normal">/ 10</span>
                </div>
                <div id="todayLabel" class="text-xs text-slate-600 font-medium mt-1">Loading...</div>
            </div>
            <div id="todayEmoji" class="text-4xl p-3 bg-purple-50 rounded-2xl border border-purple-100">
                😌
            </div>
        </div>

        <!-- Week Average -->
        <div class="glass-card p-5 rounded-2xl border-l-4 border-l-pink-500 shadow-sm flex items-center justify-between">
            <div>
                <div class="text-xs font-semibold text-pink-700 uppercase tracking-wider mb-1">This Week's Average</div>
                <div class="text-3xl font-bold font-heading text-slate-800 flex items-baseline gap-2">
                    <span id="weekAvgText">—</span>
                    <span class="text-xs text-slate-500 font-normal">/ 10</span>
                </div>
                <div id="weekLabel" class="text-xs text-slate-600 font-medium mt-1">Loading...</div>
            </div>
            <div id="weekEmoji" class="text-4xl p-3 bg-pink-50 rounded-2xl border border-pink-100">
                🙂
            </div>
        </div>

        <!-- Month Average -->
        <div class="glass-card p-5 rounded-2xl border-l-4 border-l-purple-600 shadow-sm flex items-center justify-between">
            <div>
                <div class="text-xs font-semibold text-purple-800 uppercase tracking-wider mb-1">This Month's Average</div>
                <div class="text-3xl font-bold font-heading text-slate-800 flex items-baseline gap-2">
                    <span id="monthAvgText">—</span>
                    <span class="text-xs text-slate-500 font-normal">/ 10</span>
                </div>
                <div id="monthLabel" class="text-xs text-slate-600 font-medium mt-1">Loading...</div>
            </div>
            <div id="monthEmoji" class="text-4xl p-3 bg-purple-50 rounded-2xl border border-purple-100">
                😟
            </div>
        </div>

    </div>

    <!-- Chart Panel with Range Filter Toggle -->
    <div class="glass-card p-6 rounded-3xl border border-purple-100 shadow-md mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <h2 class="font-heading text-xl font-bold text-slate-800">Anxiety & Mood Trends</h2>
                <p class="text-xs text-slate-500">Visualizing emotional score progression</p>
            </div>

            <!-- Range Filter Toggle Buttons -->
            <div class="inline-flex p-1 bg-purple-50 border border-purple-100 rounded-2xl gap-1">
                <button data-range="day" class range-tab-btn px-4 py-1.5 rounded-xl text-xs font-semibold transition-all bg-purple-50 text-purple-700 hover:bg-purple-100">
                    Day
                </button>
                <button data-range="week" class="range-tab-btn px-4 py-1.5 rounded-xl text-xs font-semibold transition-all bg-gradient-sahay text-white shadow-md">
                    Week
                </button>
                <button data-range="month" class="range-tab-btn px-4 py-1.5 rounded-xl text-xs font-semibold transition-all bg-purple-50 text-purple-700 hover:bg-purple-100">
                    Month
                </button>
            </div>
        </div>

        <!-- Chart Canvas Container -->
        <div class="relative w-full h-[320px]">
            <canvas id="anxietyChart"></canvas>
        </div>
    </div>

    <!-- Timeline Journal List -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="font-heading text-xl font-bold text-slate-800 flex items-center gap-2">
                <span>Recent Reflections</span>
                <span>📜</span>
            </h2>
            <span class="text-xs text-slate-500">Sorted newest first</span>
        </div>

        <div id="timelineContainer" class="space-y-3">
            <!-- Timeline entries rendered dynamically via journey.js -->
            <div class="text-center py-8 text-slate-400">Loading timeline...</div>
        </div>
    </div>

</div>

<!-- Modal: + Add Entry -->
<div id="addEntryModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl border border-purple-100 animate-fade-in relative">
        
        <button id="closeAddModalBtn" class="absolute top-5 right-5 text-slate-400 hover:text-slate-600 text-xl font-bold">
            &times;
        </button>

        <h3 class="font-heading text-2xl font-bold text-slate-800 mb-2">Log Mood Entry 🌸</h3>
        <p class="text-slate-600 text-sm mb-6">Record how you are feeling right now to build your journey record.</p>

        <form id="addEntryForm" class="space-y-6">
            
            <!-- Live Emoji Slider -->
            <div class="bg-purple-50/60 p-4 rounded-2xl border border-purple-100 text-center">
                <div id="modalEmoji" class="text-5xl mb-2 animate-bounce">😟</div>
                <div id="modalLabel" class="font-heading font-semibold text-slate-800 text-sm mb-3">5/10 - Moderate</div>
                <input type="range" id="modalSlider" min="1" max="10" value="5" class="w-full">
                <div class="flex justify-between text-[11px] text-slate-400 mt-2">
                    <span>1 😌 Calm</span>
                    <span>5 😟 Moderate</span>
                    <span>10 🥵 Severe</span>
                </div>
            </div>

            <!-- Short Thought Input (~100 chars) -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                    Short Thought / Reflection (~100 chars)
                </label>
                <textarea id="modalThought" 
                          rows="3" 
                          maxlength="200"
                          placeholder="What is making you feel this way? (Optional)..." 
                          class="w-full bg-slate-50 border border-purple-100 rounded-2xl p-3 text-sm focus:outline-none focus:border-sahayPurple transition-colors resize-none"></textarea>
            </div>

            <div class="flex justify-end gap-3">
                <button type="button" 
                        onclick="document.getElementById('addEntryModal').classList.add('hidden')"
                        class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors">
                    Cancel
                </button>
                <button type="submit" 
                        class="bg-gradient-sahay text-white px-6 py-2.5 rounded-xl font-semibold text-sm shadow-md hover:opacity-95 transition-opacity">
                    Save Entry ✅
                </button>
            </div>

        </form>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script src="{{ url_for('static', filename='js/journey.js') }}"></script>
{% endblock %}
