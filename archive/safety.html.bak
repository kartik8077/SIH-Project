{% extends "base.html" %}

{% block title %}Safety & Crisis Resources — SAHAY-V{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 py-8">

    <!-- Top Immediate Danger Box (Soft Red/Warm Orange, Calm) -->
    <div class="bg-gradient-to-r from-orange-500/90 to-red-500/90 text-white p-6 md:p-8 rounded-3xl shadow-xl mb-10 relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 opacity-15 text-9xl pointer-events-none">🆘</div>
        
        <div class="relative z-10">
            <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md px-3.5 py-1.5 rounded-full text-xs font-semibold mb-3">
                <span>🆘 Immediate Assistance</span>
            </div>
            
            <h1 class="text-2xl md:text-3xl font-bold font-heading mb-3">
                If you are in immediate danger or distress
            </h1>
            
            <p class="text-orange-50 text-sm md:text-base leading-relaxed mb-6 max-w-2xl">
                Please know that you do not have to carry this alone. If you feel unsafe, are thinking about self-harm, 
                or need urgent emotional support, reach out immediately to trained helpline professionals or go to your nearest medical emergency room.
            </p>

            <div class="flex flex-wrap items-center gap-4">
                <a href="tel:9152987821" 
                   class="bg-white text-orange-600 font-bold px-5 py-3 rounded-2xl shadow hover:bg-orange-50 transition-colors flex items-center gap-2 text-sm sm:text-base">
                    <span>📞 Call iCall Helpline</span>
                </a>
                <a href="#helplines" 
                   class="bg-white/10 hover:bg-white/20 text-white font-medium px-5 py-3 rounded-2xl backdrop-blur-sm transition-colors text-sm sm:text-base">
                    View All Crisis Lines &darr;
                </a>
            </div>
        </div>
    </div>

    <!-- Section 1: 🆘 Crisis Helplines (India) -->
    <section id="helplines" class="mb-12">
        <h2 class="font-heading text-2xl font-bold text-slate-800 mb-2 flex items-center gap-2">
            <span>🆘 Free 24/7 Crisis Helplines (India)</span>
        </h2>
        <p class="text-slate-600 text-sm mb-6">Tap any number below to connect directly on mobile.</p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- Helpline 1: iCall -->
            <div class="glass-card p-6 rounded-2xl border-l-4 border-l-orange-500 hover:shadow-md transition-shadow">
                <div class="text-xs font-semibold text-orange-600 uppercase tracking-wider mb-1">TISS Initiative</div>
                <h3 class="font-heading text-xl font-bold text-slate-800 mb-1">iCall Helpline</h3>
                <p class="text-xs text-slate-500 mb-4">Mon–Sat, 10 AM – 8 PM &bull; Psychosocial counseling</p>
                <a href="tel:9152987821" class="bg-orange-100 hover:bg-orange-200 text-orange-800 font-bold py-2.5 px-4 rounded-xl text-center block text-sm transition-colors">
                    📞 9152987821
                </a>
            </div>

            <!-- Helpline 2: Vandrevala Foundation -->
            <div class="glass-card p-6 rounded-2xl border-l-4 border-l-purple-500 hover:shadow-md transition-shadow">
                <div class="text-xs font-semibold text-purple-600 uppercase tracking-wider mb-1">24/7 Mental Health</div>
                <h3 class="font-heading text-xl font-bold text-slate-800 mb-1">Vandrevala Helpline</h3>
                <p class="text-xs text-slate-500 mb-4">Available 24 hours / 7 days a week</p>
                <a href="tel:18602662345" class="bg-purple-100 hover:bg-purple-200 text-purple-800 font-bold py-2.5 px-4 rounded-xl text-center block text-sm transition-colors">
                    📞 1860-2662-345
                </a>
            </div>

            <!-- Helpline 3: KIRAN -->
            <div class="glass-card p-6 rounded-2xl border-l-4 border-l-pink-500 hover:shadow-md transition-shadow">
                <div class="text-xs font-semibold text-pink-600 uppercase tracking-wider mb-1">Govt. Helpline</div>
                <h3 class="font-heading text-xl font-bold text-slate-800 mb-1">KIRAN Helpline</h3>
                <p class="text-xs text-slate-500 mb-4">24/7 National Mental Health Rehabilitation</p>
                <a href="tel:18005990019" class="bg-pink-100 hover:bg-pink-200 text-pink-800 font-bold py-2.5 px-4 rounded-xl text-center block text-sm transition-colors">
                    📞 1800-599-0019
                </a>
            </div>

        </div>
    </section>

    <!-- Section 2: 🌬️ Interactive Breathing Exercise -->
    <section class="mb-12">
        <div class="glass-card p-6 md:p-8 rounded-3xl border border-purple-100 shadow-md text-center">
            <div class="inline-block p-3 bg-purple-50 rounded-2xl text-3xl mb-3">🌬️</div>
            <h2 class="font-heading text-2xl font-bold text-slate-800 mb-2">Guided Box Breathing Exercise</h2>
            <p class="text-slate-600 text-sm max-w-md mx-auto mb-8">
                Regulate your nervous system with a 4-4-4 breathing cycle: Inhale for 4s, Hold for 4s, Exhale for 4s.
            </p>

            <!-- Visual Animated Breathing Circle -->
            <div class="flex flex-col items-center justify-center my-6">
                <div id="breathCircle" class="w-40 h-40 rounded-full bg-purple-50 border-4 border-purple-200 flex items-center justify-center transition-all duration-1000 shadow-inner">
                    <div class="text-center p-2">
                        <div id="breathLabel" class="font-heading text-xl font-bold text-purple-700">Ready</div>
                        <div id="breathTimerText" class="text-xs text-slate-500 mt-1">Press start below</div>
                    </div>
                </div>
            </div>

            <button id="breathToggleBtn" 
                    class="bg-gradient-sahay text-white font-semibold px-8 py-3.5 rounded-2xl shadow-lg hover:shadow-xl active:scale-95 transition-all text-sm sm:text-base">
                Start Breathing Exercise 🌬️
            </button>
        </div>
    </section>

    <!-- Section 3: 🖐️ 5-4-3-2-1 Grounding Technique -->
    <section class="mb-12">
        <div class="glass-card p-6 md:p-8 rounded-3xl border border-purple-100 shadow-md">
            <div class="flex items-center gap-3 mb-4">
                <span class="text-3xl p-2 bg-pink-50 rounded-2xl">🖐️</span>
                <div>
                    <h2 class="font-heading text-2xl font-bold text-slate-800">5-4-3-2-1 Grounding Technique</h2>
                    <p class="text-slate-600 text-xs sm:text-sm">Use your five senses to bring your focus back to the present moment.</p>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="mb-6 bg-purple-50 p-4 rounded-2xl border border-purple-100">
                <div class="flex justify-between text-xs font-semibold text-purple-900 mb-1.5">
                    <span>Grounding Progress</span>
                    <span id="groundingProgressText">0 of 5 steps completed (0%)</span>
                </div>
                <div class="w-full h-3 bg-purple-200/60 rounded-full overflow-hidden">
                    <div id="groundingProgress" class="h-full bg-gradient-sahay transition-all duration-500 w-0"></div>
                </div>
            </div>

            <!-- Interactive Step Checklist -->
            <div class="space-y-4">
                
                <!-- Step 5: See -->
                <label class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-purple-100 hover:bg-purple-50/50 cursor-pointer transition-colors">
                    <input type="checkbox" class="grounding-check mt-1 w-5 h-5 rounded text-sahayPurple focus:ring-sahayPurple">
                    <div>
                        <span class="font-heading font-bold text-slate-800 block text-base">5 Things You Can SEE 👁️</span>
                        <span class="text-slate-600 text-xs sm:text-sm">Look around you right now. Spot 5 distinct objects (e.g., a clock, a plant, a shadow, a pen, light through a window).</span>
                    </div>
                </label>

                <!-- Step 4: Feel -->
                <label class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-purple-100 hover:bg-purple-50/50 cursor-pointer transition-colors">
                    <input type="checkbox" class="grounding-check mt-1 w-5 h-5 rounded text-sahayPurple focus:ring-sahayPurple">
                    <div>
                        <span class="font-heading font-bold text-slate-800 block text-base">4 Things You Can FEEL 🖐️</span>
                        <span class="text-slate-600 text-xs sm:text-sm">Notice 4 tactile sensations (e.g., your feet touching the floor, your hair on your neck, fabric on your skin, a cool desk surface).</span>
                    </div>
                </label>

                <!-- Step 3: Hear -->
                <label class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-purple-100 hover:bg-purple-50/50 cursor-pointer transition-colors">
                    <input type="checkbox" class="grounding-check mt-1 w-5 h-5 rounded text-sahayPurple focus:ring-sahayPurple">
                    <div>
                        <span class="font-heading font-bold text-slate-800 block text-base">3 Things You Can HEAR 👂</span>
                        <span class="text-slate-600 text-xs sm:text-sm">Listen closely to subtle sounds around you (e.g., a fan humming, distant traffic, your own breathing).</span>
                    </div>
                </label>

                <!-- Step 2: Smell -->
                <label class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-purple-100 hover:bg-purple-50/50 cursor-pointer transition-colors">
                    <input type="checkbox" class="grounding-check mt-1 w-5 h-5 rounded text-sahayPurple focus:ring-sahayPurple">
                    <div>
                        <span class="font-heading font-bold text-slate-800 block text-base">2 Things You Can SMELL 👃</span>
                        <span class="text-slate-600 text-xs sm:text-sm">Identify 2 scents around you (e.g., fresh air, tea/coffee, soap, paper). If hard to detect, recall 2 favorite relaxing scents.</span>
                    </div>
                </label>

                <!-- Step 1: Taste -->
                <label class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-purple-100 hover:bg-purple-50/50 cursor-pointer transition-colors">
                    <input type="checkbox" class="grounding-check mt-1 w-5 h-5 rounded text-sahayPurple focus:ring-sahayPurple">
                    <div>
                        <span class="font-heading font-bold text-slate-800 block text-base">1 Thing You Can TASTE 👅</span>
                        <span class="text-slate-600 text-xs sm:text-sm">Notice any taste in your mouth, take a sip of cool water, or savor a mint.</span>
                    </div>
                </label>

            </div>
        </div>
    </section>

    <!-- Section 4: 💛 You're Not Alone Reassurance -->
    <div class="glass-card p-6 rounded-2xl bg-gradient-to-r from-purple-50 to-pink-50 border border-purple-100 text-center">
        <span class="text-4xl">💛</span>
        <h3 class="font-heading text-xl font-bold text-slate-800 mt-2 mb-1">You Are Not Alone</h3>
        <p class="text-slate-600 text-xs sm:text-sm max-w-xl mx-auto">
            Anxiety is a temporary visitor, not your permanent identity. Take one moment at a time.
        </p>
    </div>

</div>
{% block extra_scripts %}
<script src="{{ url_for('static', filename='js/safety.js') }}"></script>
{% endblock %}
{% endblock %}
